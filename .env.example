# Copy to backend/.env for local backend execution.
ENV=development
DEMO_MODE=true
AUTH_MODE=demo
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

RATE_LIMIT_PER_MINUTE=30
AGENT_TIMEOUT_SECONDS=25
MAX_ORDER_AMOUNT=10000
IMPACT_RATE=0.01
IMPACT_USD_PER_TREE=1
MIN_TRUST_SCORE=0.5
